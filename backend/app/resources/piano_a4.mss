<?xml version="1.0" encoding="UTF-8"?>
<museScore version="4.60">
  <Style>
    <!-- ISO A4 in inches. Narrow but print-safe margins leave room for dense piano music. -->
    <pageWidth>8.26772</pageWidth>
    <pageHeight>11.6929</pageHeight>
    <pagePrintableWidth>7.32284</pagePrintableWidth>
    <pageEvenLeftMargin>0.47244</pageEvenLeftMargin>
    <pageOddLeftMargin>0.47244</pageOddLeftMargin>
    <pageEvenTopMargin>0.51181</pageEvenTopMargin>
    <pageEvenBottomMargin>0.51181</pageEvenBottomMargin>
    <pageOddTopMargin>0.51181</pageOddTopMargin>
    <pageOddBottomMargin>0.51181</pageOddBottomMargin>
    <pageTwosided>0</pageTwosided>

    <!-- MuseScore's official Grand Staff template: Leland symbols and Edwin text. -->
    <musicalSymbolFont>Leland</musicalSymbolFont>
    <musicalTextFont>Leland Text</musicalTextFont>
    <defaultFontFace>Edwin</defaultFontFace>
    <titleFontFace>Edwin</titleFontFace>
    <tempoFontFace>Edwin</tempoFontFace>
    <metronomeFontFace>Edwin</metronomeFontFace>
    <measureNumberFontFace>Edwin</measureNumberFontFace>
    <ottavaFontFace>Edwin</ottavaFontFace>
    <ottavaFontSize>10</ottavaFontSize>
    <ottavaNumbersOnly>1</ottavaNumbersOnly>
    <ottava8VAText>8va</ottava8VAText>
    <ottava8VAContinueText>(8va)</ottava8VAContinueText>
    <ottava8VBText>8vb</ottava8VBText>
    <ottava8VBContinueText>(8vb)</ottava8VBContinueText>
    <!-- Keep numeric ottava labels outside beams, ledger lines, and chord stacks. -->
    <ottavaPosAbove x="0" y="-2.7"/>
    <ottavaPosBelow x="0" y="2.7"/>
    <ottavaHookAbove>1</ottavaHookAbove>
    <ottavaHookBelow>1</ottavaHookBelow>
    <ottavaLineWidth>0.11</ottavaLineWidth>
    <ottavaLineStyle>2</ottavaLineStyle>
    <ottavaMinDistance>1.2</ottavaMinDistance>
    <Spatium>1.65</Spatium>

    <!-- Performer-oriented grand-staff spacing: compact horizontally, open vertically. -->
    <staffDistance>6.5</staffDistance>
    <akkoladeDistance>6.5</akkoladeDistance>
    <minSystemDistance>8.2</minSystemDistance>
    <maxSystemDistance>13</maxSystemDistance>
    <minNoteDistance>0.42</minNoteDistance>
    <measureSpacing>1.45</measureSpacing>
    <!-- Do not stretch a sparse final system across the full page width. -->
    <lastSystemFillLimit>0.55</lastSystemFillLimit>
  </Style>
</museScore>
